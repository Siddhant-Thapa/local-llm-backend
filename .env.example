# ============================================================
# LOCAL DEVELOPMENT ONLY — copy to .env and fill in values.
# Never commit .env to git.
# Production (EC2): create .env directly on the instance with
# the RDS endpoint. The RDS URL must never appear in this file
# or anywhere in the repository.
# ============================================================

# PostgreSQL — local instance on localhost:5432
# Production: replace with RDS endpoint in your .env on EC2 (never here)
DATABASE_URL=postgresql+asyncpg://llmchat:llmchat@localhost:5432/llmchat

# llama.cpp HTTP server (OpenAI-compatible API)
LLAMA_SERVER_URL=http://localhost:8080
LLAMA_MODEL_NAME=tinyllama

# FastAPI
API_SECRET_KEY=change-me-in-production

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
